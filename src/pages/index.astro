---
import { getCollection } from 'astro:content';
import Layout from '../layouts/Layout.astro';

const allPosts = await getCollection('posts');
const posts = allPosts.sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf());

const dateFormatter = new Intl.DateTimeFormat('ko-KR', {
	year: 'numeric',
	month: 'long',
	day: 'numeric',
	weekday: 'short',
});

const groups = new Map<string, typeof posts>();
for (const post of posts) {
	const key = dateFormatter.format(post.data.date);
	if (!groups.has(key)) groups.set(key, []);
	groups.get(key)!.push(post);
}
---

<Layout title="홈">
	{posts.length === 0 && (
		<p class="empty">아직 발행된 다이제스트가 없습니다.</p>
	)}

	{Array.from(groups.entries()).map(([dateLabel, dayPosts]) => (
		<section class="day-group">
			<h2 class="day-label">{dateLabel}</h2>
			<div class="cards">
				{dayPosts.map((post) => (
					<a class="card" href={`/posts/${post.id}/`}>
						<span class="tag">{post.data.category}</span>
						<h3>{post.data.title}</h3>
						<p class="summary">{post.data.summary}</p>
						<span class="source">{post.data.sourceName}</span>
					</a>
				))}
			</div>
		</section>
	))}
</Layout>

<style>
	.empty {
		color: var(--color-muted);
		text-align: center;
		padding: 3rem 0;
	}

	.day-group + .day-group {
		margin-top: 2.5rem;
	}

	.day-label {
		font-size: 0.95rem;
		font-weight: 700;
		color: var(--color-muted);
		margin-bottom: 1rem;
		padding-bottom: 0.5rem;
		border-bottom: 1px solid var(--color-border);
	}

	.cards {
		display: flex;
		flex-direction: column;
		gap: 1rem;
	}

	.card {
		display: block;
		background: var(--color-surface);
		border: 1px solid var(--color-border);
		border-radius: 12px;
		padding: 1.25rem 1.5rem;
		text-decoration: none;
		color: var(--color-text);
		transition: border-color 0.15s ease, box-shadow 0.15s ease;
	}

	.card:hover {
		border-color: var(--color-accent);
		box-shadow: 0 2px 10px rgba(31, 78, 121, 0.08);
	}

	.card h3 {
		margin: 0.6rem 0 0.4rem;
		font-size: 1.1rem;
		line-height: 1.4;
	}

	.summary {
		margin: 0 0 0.6rem;
		color: var(--color-text);
		font-size: 0.95rem;
	}

	.source {
		font-size: 0.8rem;
		color: var(--color-muted);
	}
</style>
